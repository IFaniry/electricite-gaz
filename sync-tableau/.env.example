# ==============================================================================
# Environment Configuration for sync-tableau
# ==============================================================================

# Target Google Spreadsheet ID
# (from Google Sheets URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=your_google_spreadsheet_id_here

# Local machine: path to Service Account credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Cloud Run / CI: Alternative raw JSON key string (uncomment if using env variable)
# GCP_SA_KEY={"type": "service_account", "project_id": "...", ...}

# Processing parameters
START_YEAR=2020
DATA_DIR=../brainstorm-data
CHUNK_SIZE=5000
